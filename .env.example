# Rail Incident Intelligence – environment configuration
# Copy to .env and adjust values as needed.
# The .env file is gitignored - never commit real secrets.

RAIL_II_DEBUG=false
RAIL_II_DATA_DIR=data

# OpenAI provider configuration. Required only when using the LLM extractor.
# Get a key at https://platform.openai.com/api-keys
RAIL_II_OPENAI_API_KEY=sk-replace-me
RAIL_II_OPENAI_MODEL=gpt-4o-mini
